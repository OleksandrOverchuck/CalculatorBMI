<Window x:Class="BMICalculatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BMICalculatorApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="20">

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label x:Name="HeightLabel" Content="Height (cm):" VerticalAlignment="Center" Grid.Column="0"/>
            <TextBox x:Name="HeightTextBox" VerticalAlignment="Center" Grid.Column="1" Margin="5,0,0,0"/>
        </Grid>

        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label x:Name="WeightLabel" Content="Weight (kg):" VerticalAlignment="Center" Grid.Column="0"/>
            <TextBox x:Name="WeightTextBox" VerticalAlignment="Center" Grid.Column="1" Margin="5,0,0,0"/>
        </Grid>

        <Button x:Name="CalculateButton" Content="Calculate BMI" Click="CalculateButton_Click" Margin="0,0,0,10" Padding="5"/>
        <Button x:Name="ResetButton" Content="Reset" Click="ResetButton_Click" Margin="0,0,0,15" Padding="5"/>

        <Label x:Name="ResultLabel" Content="BMI: -" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"/>

    </StackPanel>
</Window>
